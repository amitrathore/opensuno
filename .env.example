# For more information, please see the README.md
SUNO_COOKIE=
TWOCAPTCHA_KEY= # Obtain from 2captcha.com
BROWSER=chromium # `chromium` or `firefox`, although `chromium` is highly recommended
BROWSER_GHOST_CURSOR=false
BROWSER_LOCALE=en
BROWSER_HEADLESS=true

# Local bridge/MCP listener. Keep this loopback-only unless you add authentication and TLS.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3001

# Generation default. Override per request with the `model` field.
# Set to chirp-crow to roll back to V5.
SUNO_DEFAULT_MODEL=chirp-hawk
